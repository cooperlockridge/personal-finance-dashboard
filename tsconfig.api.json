{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,

    /* Vercel runs api/ as Node ESM (package.json says "type": "module"), and
       Node ESM needs real file extensions on relative imports. nodenext makes
       tsc demand the .js spelling Node will resolve at runtime. */
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Tests live in test/api and run under bun, whose bun:test types are not
     installed, so tsc only checks the functions themselves. */
  "include": ["api"]
}
